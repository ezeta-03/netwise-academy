# Modo emulador: npm run emulators + npm run dev:emu. Proyecto "demo-*" =
# Firebase nunca contacta servicios reales. Integraciones externas apagadas.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-netwise.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-netwise
VITE_FIREBASE_STORAGE_BUCKET=demo-netwise.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:demo
VITE_LEADS_WEBAPP_URL=
VITE_LEADS_WEBAPP_SECRET=
VITE_MASTERCLASS_WEBAPP_URL=
VITE_MASTERCLASS_WEBAPP_SECRET=
VITE_GROQ_API_KEY=
