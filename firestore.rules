rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isTeacherOrAdmin() {
      return isSignedIn() && (myRole() == 'teacher' || myRole() == 'admin');
    }

    // Un docente solo gobierna los cursos que el Admin le asignó
    // (courseOfferings/{curso}.teacherUid, ver Admin > Cursos). `courseIdStr`
    // es el id del curso como texto (los ids de los docs guardan el número).
    function isCourseTeacher(courseIdStr) {
      return isSignedIn() && myRole() == 'teacher'
        && exists(/databases/$(database)/documents/courseOfferings/$(courseIdStr))
        && get(/databases/$(database)/documents/courseOfferings/$(courseIdStr)).data.teacherUid == request.auth.uid;
    }

    // Admin (cualquier curso) o el docente asignado a ese curso.
    function canManageCourse(courseIdStr) {
      return isAdmin() || isCourseTeacher(courseIdStr);
    }

    // Catálogo público: cualquiera puede leer, solo un admin escribe
    // (la app hoy no tiene un flujo de escritura desde el cliente para
    // estas colecciones; se editan vía consola o el script scripts/seed.mjs).
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Apertura de cohorte: precio y fecha de inicio por taller. Público en
    // lectura (se muestra en /catalog y /course/:id sin necesidad de login),
    // solo el Admin decide cuándo "abrir" un taller.
    match /courseOfferings/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Temario real de cada taller (módulos/lecciones con video y
    // materiales). Solo usuarios logueados lo leen (se consume desde el
    // reproductor, que ya requiere sesión); solo docentes/admin lo editan.
    match /courseContent/{courseId} {
      allow read: if isSignedIn();
      allow write: if canManageCourse(courseId);
    }

    // Rúbrica de evaluación del curso (ver TeacherCourseRubrica.jsx): a
    // diferencia de courseContent, es exclusiva del docente -- el estudiante
    // nunca la lee, ni siquiera los descriptores de nivel.
    match /courseRubrics/{courseId} {
      allow read: if canManageCourse(courseId);
      allow write: if canManageCourse(courseId);
    }

    // Copia pública del temario (solo título/semanas de cada módulo, sin
    // links de video ni materiales) -- se muestra en /course/:id a un
    // visitante sin sesión, junto con el botón de descarga del programa que
    // captura su contacto (ver `programLeads`). La escribe saveCourseContent
    // junto con `courseContent`, así que mismo permiso de escritura.
    match /courseSummaries/{courseId} {
      allow read: if true;
      allow write: if canManageCourse(courseId);
    }

    // Clases en vivo: cualquier usuario autenticado puede verlas. Solo
    // docentes/admin pueden programarlas (la que crea queda como dueña vía
    // instructorUid); cualquier docente/admin puede editarla/cancelarla/
    // borrarla -- igual que el contenido de un curso (courseContent), ningún
    // docente está limitado a "sus" cursos en esta app, así que restringir
    // la edición al creador original solo generaba permission-denied cuando
    // otro docente entraba a gestionar el mismo curso -- antes CUALQUIER
    // usuario logueado, incluyendo estudiantes, podía modificar o borrar la
    // clase de otro, que sí seguimos evitando.
    match /liveSessions/{sessionId} {
      allow read: if isSignedIn();
      // Admin programa clases (incluido el calendario que genera al crear un
      // aula, a nombre del docente del aula); un docente solo las de SU curso
      // y a su nombre.
      allow create: if isAdmin() || (isCourseTeacher(string(request.resource.data.courseId)) && request.resource.data.instructorUid == request.auth.uid);
      allow update, delete: if canManageCourse(string(resource.data.courseId));
    }

    // Preinscripciones ("me interesa este taller"): un alumno solo puede
    // crear/leer sus propios registros; un admin puede leerlos todos para
    // ver quién está interesado en cada taller. No se actualizan ni borran
    // desde el cliente -- doc id = `${uid}_${courseId}` evita duplicados.
    match /preregistrations/{regId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Inscripciones y progreso reales: un alumno solo puede crear/leer/
    // actualizar su propia inscripción (progreso, lecciones completadas);
    // un docente/admin puede leerlas todas (dashboards de curso/grupo); un
    // admin además puede crearlas manualmente para otro alumno (matrícula
    // manual, ver adminCreateEnrollment) con un uid sintético. No se borran
    // desde el cliente.
    // `resource == null` cubre el `get()` que hace enrollInCourse/
    // markLessonComplete para revisar si el doc ya existe antes de crearlo --
    // sin ese permiso, leer un doc que todavía no existe da permission-denied
    // en vez de "no existe", porque `resource` es null y no tiene `.data`.
    // El `exists(...)` cubre a un alumno viendo a sus compañeros del mismo
    // curso (ej. para armar una sala privada, ver fetchCourseClassmates):
    // puede leer la matrícula de OTRO alumno solo si él mismo tiene una
    // propia matrícula para ese mismo courseId -- el id determinístico
    // `${uid}_${courseId}` que usa enrollInCourse/markLessonComplete es lo
    // que permite comprobar eso sin necesitar una query aparte. Una
    // matrícula manual del admin (id autogenerado, ver adminCreateEnrollment)
    // no matchea ese id, así que ese alumno en particular no vería
    // compañeros por esta vía -- sigue viendo la suya propia igual.
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (
                    resource == null ||
                    resource.data.uid == request.auth.uid ||
                    canManageCourse(string(resource.data.courseId)) ||
                    exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + string(resource.data.courseId)))
                  );
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isAdmin());
      // Un alumno solo actualiza su avance (lecciones completadas / progreso):
      // no puede cambiarse el estado, el aula ni el seguimiento de su matrícula.
      // El docente asignado a ese curso solo puede tocar el seguimiento
      // (followUp); estado/aula/acceso de la matrícula son del Admin.
      allow update: if isSignedIn() && (
                      (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'courseId', 'completedLessonIds', 'progress', 'updatedAt'])) ||
                      isAdmin() ||
                      (isCourseTeacher(string(resource.data.courseId)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followUp']))
                    );
      // Solo el admin borra -- para limpiar matrículas de prueba desde
      // Admin > Alumnos y accesos (ver deleteEnrollment en lib/db.js).
      allow delete: if isAdmin();
    }

    // Perfiles con rol. Un usuario puede crear/leer su propio doc, pero solo
    // como 'student' (evita que alguien se auto-asigne admin/teacher tocando
    // Firestore directamente). Cambiar de rol requiere ser admin -- excepto
    // el propio rol de un admin, que nadie (ni él mismo) puede degradar,
    // para que no pueda quedarse bloqueado fuera del panel por accidente.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'student';
      allow update: if (isAdmin() &&
                          !(request.auth.uid == userId
                            && resource.data.role == 'admin'
                            && request.resource.data.role != 'admin')) ||
                    (isSignedIn() && request.auth.uid == userId
                     && request.resource.data.role == resource.data.role);
      // Solo el admin borra -- para limpiar cuentas de prueba desde
      // Admin > Equipo y permisos (ver deleteUserProfile en lib/db.js). Ojo:
      // esto borra el perfil/rol en Firestore, no la cuenta de Firebase Auth
      // (eso requeriría el Admin SDK, que este proyecto no tiene expuesto)
      // -- si esa persona vuelve a iniciar sesión, ensureUserProfile le crea
      // un perfil nuevo como 'student'. Para bloquearla de verdad, usar
      // "Desactivar" (campo `disabled`), no "Eliminar".
      allow delete: if isAdmin();
    }

    // Directorio interno del equipo (Admin > Equipo y permisos). Es una
    // propuesta de alcance, no el rol real (ver `users`) -- solo el admin la
    // ve y la edita.
    match /teamMembers/{memberId} {
      allow read, write: if isAdmin();
    }

    // Cupones de descuento. Lectura pública porque el checkout valida un
    // cupón antes de que el comprador tenga sesión iniciada; solo el admin
    // los crea/edita. El canje (contador de usos) también es una escritura
    // de "cupones", así que cualquier usuario logueado puede incrementarla
    // al confirmar su compra.
    match /coupons/{couponId} {
      allow read: if true;
      allow update: if isSignedIn();
      allow create, delete: if isAdmin();
    }

    // Aulas / grupos: fechas, cupos y docente de cada edición de un curso.
    // Cualquier usuario logueado las lee (docentes/alumnos ven su aula);
    // solo el admin las crea/edita.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Pedidos (pagos). Un alumno crea y lee sus propios pedidos; el admin
    // los lee todos (Ventas e inscripciones). No se editan desde el cliente.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Un pago manual (Yape/Transferencia) entra como 'pending' y solo el
      // admin puede pasarlo a 'paid' al validar el comprobante -- ver
      // approveOrder en lib/db.js.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Bitácora de cambios del panel de Admin. Solo el admin la ve y escribe
    // en ella.
    match /auditLog/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Entregas de un módulo: un alumno crea/actualiza su propia entrega
    // (uid propio); un docente/admin puede marcarla revisada. Se lee por
    // ambos roles (el alumno ve su estado en "Mis entregas", el docente ve
    // la lista completa para calificar).
    //
    // El alumno solo lee SUS entregas (nunca las notas de un compañero) y,
    // al escribir, solo puede dejarlas en 'submitted' sobre un doc que ya es
    // suyo (el id lleva su uid) sin tocar nota ni comentario: nota y estado
    // 'reviewed' los pone solo el docente/admin.
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (canManageCourse(string(resource.data.courseId)) || resource.data.uid == request.auth.uid);
      allow create: if canManageCourse(string(request.resource.data.courseId)) || (
        isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && submissionId.matches(request.auth.uid + '_.*')
        && request.resource.data.status == 'submitted'
        && !('grade' in request.resource.data)
        && !('feedback' in request.resource.data)
      );
      allow update: if canManageCourse(string(resource.data.courseId)) || (
        isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.get('grade', null) == resource.data.get('grade', null)
        && request.resource.data.get('feedback', null) == resource.data.get('feedback', null)
      );
      allow delete: if canManageCourse(string(resource.data.courseId));
    }

    // Notas de los componentes que el docente califica directo (sustentación,
    // participación, caso...): un doc por alumno+curso. Las escribe solo el
    // admin o el docente asignado al curso; el alumno lee únicamente la suya.
    match /courseGrades/{gradeId} {
      allow read: if isSignedIn() && (canManageCourse(string(resource.data.courseId)) || resource.data.uid == request.auth.uid);
      allow create, update: if canManageCourse(string(request.resource.data.courseId));
      allow delete: if canManageCourse(string(resource.data.courseId));
    }

    // Asistencia por sesión: un doc por alumno+sesión. La toma el docente
    // (columna clicable en Asistencia); el alumno solo la lee (Mi asistencia).
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() && (canManageCourse(string(resource.data.courseId)) || resource.data.uid == request.auth.uid);
      allow create, update: if canManageCourse(string(request.resource.data.courseId));
      allow delete: if canManageCourse(string(resource.data.courseId));
    }

    // Grupos de trabajo del proyecto (equipos que arman los alumnos, o que
    // crea el docente). Cualquier usuario logueado del curso puede crear el
    // suyo y actualizar integrantes/invitaciones (aceptar, unirse, invitar);
    // mismo nivel de confianza que communityPosts. Solo docente/admin borra.
    match /workGroups/{groupId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if canManageCourse(string(resource.data.courseId));
    }

    // Comunidad de un curso/grupo. Cualquier alumno/docente del curso lee;
    // solo el docente/admin publica anuncios; los comentarios (append al
    // array `comments` vía update) los agrega cualquier usuario logueado.
    match /communityPosts/{postId} {
      allow read: if isSignedIn();
      // Anuncios: solo el admin o el docente asignado a ese curso.
      allow create: if canManageCourse(string(request.resource.data.courseId));
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Soporte y tutorías. Un usuario crea/lee sus propias solicitudes; el
    // admin puede leerlas todas y es el único que puede actualizar su estado
    // (ej. marcarla "resuelta") desde Admin > Soporte.
    match /supportRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.requesterUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.requesterUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Leads del programa descargable: captura de contacto antes de crear
    // cuenta, así que no requiere sesión. Solo el admin los consulta.
    match /programLeads/{leadId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // Perfil de negocio del proyecto de un alumno (una empresa/marca/idea
    // por alumno+curso). El dueño lee/escribe el suyo; el docente/admin del
    // curso puede leerlo para dar seguimiento.
    // `resource == null` cubre el `get()` que hace fetchProjectProfile antes
    // de que el alumno haya definido su proyecto todavía.
    match /projectProfiles/{profileId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || canManageCourse(string(resource.data.courseId)));
      allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Avances de práctica del proyecto (qué puntos de un módulo ya aplicó
    // el alumno a su proyecto). Mismo dueño único que projectProfiles.
    // `resource == null` cubre el `get()` que hace toggleProjectAdvance
    // antes de que exista el doc.
    match /projectAdvances/{advanceId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || canManageCourse(string(resource.data.courseId)));
      allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Salas privadas de estudio armadas por un alumno. Cualquier usuario
    // logueado las ve (para unirse); solo quien la crea puede registrarla.
    match /privateRooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Configuración general de la academia (doc único `settings/academy`),
    // incluye qué métodos de pago están activos. Lectura pública porque el
    // checkout debe poder mostrarlos incluso antes de que el comprador
    // inicie sesión; solo el admin la edita.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
