{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "netwise-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "netwise-emu",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:emu"
      ],
      "port": 5174
    },
    {
      "name": "netwise-emulators",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "firebase-tools",
        "emulators:start",
        "--project",
        "demo-netwise",
        "--only",
        "auth,firestore,storage"
      ],
      "port": 4000
    },
    {
      "name": "netwise-emulators-fn",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "firebase-tools",
        "emulators:start",
        "--project",
        "demo-netwise",
        "--only",
        "auth,firestore,storage,functions"
      ],
      "port": 4000,
      "env": {
        "FUNCTIONS_DISCOVERY_TIMEOUT": "60"
      }
    }
  ]
}